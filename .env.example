# App settings. On the VPS this file is /opt/ait/app.env (chmod 600).
APP_ENV=production                       # production | demo | development
APP_URL=https://ait.getstrategic.vip
EDUCATION_URL=https://insurance.getstrategic.vip
DATABASE_URL=postgres://ait:<db password>@db:5432/ait
BETTER_AUTH_SECRET=                      # openssl rand -hex 32
INTEGRATION_TOKEN=                       # openssl rand -hex 32; also given to the n8n installer
PROVISION_FROM=                          # go-live instant, e.g. 2026-10-03T00:00:00Z; older Twenty records need the backfill
DOCUMENT_DIR=/data/documents
MAX_UPLOAD_BYTES=15728640
TWENTY_URL=https://crm.getstrategic.vip
# Password-reset email is sent by the app directly so reset links never pass through n8n.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=celliott@platinuminsgroup.com
SMTP_PASSWORD=                           # Gmail app password
MAIL_FROM=Colton Elliott <celliott@platinuminsgroup.com>
# Adobe Acrobat Sign (leave empty until the API plan is confirmed; contracts then use admin-reviewed upload)
ADOBE_SIGN_API_BASE=
ADOBE_SIGN_ACCESS_TOKEN=
ADOBE_SIGN_CLIENT_ID=
